# ── Required ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://znnznynkeamfxrscpnal.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Auth tokens ───────────────────────────────────────────────────────────
ADMIN_API_KEY=change-me-admin-secret          # protects /mcp/admin + admin REST
INTERNAL_MCP_TOKEN=change-me-internal-token  # orchestrator → /mcp/customer

# ── NVIDIA (Phase 3 — leave blank for M0-M5) ──────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# ── DB table names (verified against live schema) ─────────────────────────
MENU_TABLE=menu_items
ORDERS_TABLE=orders
CUSTOMERS_TABLE=customers
FEEDBACK_TABLE=feedback

# ── CORS (comma-separated) ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Session / misc ────────────────────────────────────────────────────────
SESSION_TTL_HOURS=6
LOG_LEVEL=INFO
PORT=8000

# ── Latency Tuning & Telemetry ───────────────────────────────────────────────
DEBUG_TIMING=false          # Include timing breakdown in 'done' SSE events
TOOL_TIMEOUT_S=5.0          # Per-tool timeout in seconds (default 5.0)
NIM_STREAM=true             # Enable SSE token streaming from NVIDIA NIM
NIM_MAX_TOKENS=200          # Max tokens to generate per turn
HISTORY_MESSAGES=20         # Number of recent conversation messages to load
MENU_CACHE_TTL=45           # TTL in seconds for cached menu items
SESSION_CACHE_TTL=30        # TTL in seconds for session validity cache
PROFILE_CACHE_TTL=120       # TTL in seconds for customer profile cache
POPULARITY_CACHE_TTL=300    # TTL in seconds for popularity score cache
MENU_IN_PROMPT_MAX=60       # Max items before collapsing menu snapshot into categories
